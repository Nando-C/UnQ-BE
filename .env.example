# The server validates this whole file at boot (src/settings/env.ts) and exits with a
# list of every problem if anything is missing. Names and comments only — never values.

# --- Required ---
MONGO_CONNECTION=
JWT_SECRET=
JWT_REFRESH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
# Read by the cloudinary SDK itself, not by our code — uploads fail without it.
CLOUDINARY_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Stripe's secret key (Developers > API keys). sk_test_… is test mode, sk_live_… live;
# the server logs which at boot.
STRIPE_SECRET_KEY=
# The webhook endpoint's signing secret (whsec_…). Locally: stripe listen --print-secret.
STRIPE_WEBHOOK_SECRET=
# Where a browser reaches this API. When the front-end proxies the API through its
# own origin (see UNQ-FE's vercel.json), this is that proxied prefix — e.g.
# https://un-q.vercel.app/api — NOT this server's own host. Google's OAuth callback
# is built from it.
PUBLIC_API_URL=

# --- Required as a pair: at least one of each group ---
# Used for OAuth redirects and generated table QR URLs (FRONTEND_URL wins).
FRONTEND_URL=
FRONTEND_DEV_URL=
# The CORS whitelist is built from FRONTEND_DEV_URL + FRONTEND_PROD_URL only.
FRONTEND_PROD_URL=

# --- Optional (defaults shown) ---
# PORT=3001
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# NOTE: a typo in this name silently leaves you on sandbox. The server logs the
# resolved PayPal mode at boot — check that line before taking real payments.
# Rate limits: wrong passwords per account in 15 minutes, cart edits per diner a minute,
# people added (an account created or attached) per caller an hour.
# PASSWORD_FAILS_PER_ACCOUNT=10
# CART_EDITS_PER_MINUTE=120
# PEOPLE_ADDED_PER_HOUR=20
# bcrypt's cost for stored passwords, 10 to 13 (lower only in the test suite).
# BCRYPT_ROUNDS=10
# The demo data's sign-ins (npm run seed:demo): the seed refuses to run without both.
# DEMO_MANAGER_PASSWORD=
# DEMO_DINER_PASSWORD=
